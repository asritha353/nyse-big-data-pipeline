# Local demonstration credentials. Copy this file to .env and change the password.
POSTGRES_DB=nyse
POSTGRES_USER=nyseuser
POSTGRES_PASSWORD=change-me

# Airflow local-development configuration
AIRFLOW_UID=50000
AIRFLOW_API_SECRET_KEY=change-me-to-a-long-random-value
AIRFLOW_DB_PASSWORD=change-me-to-a-different-local-password
HADOOP_MASTER_CONTAINER=infrastructure-master-1
HADOOP_NETWORK=infrastructure_sparknet
SQOOP_IMAGE=nyse-sqoop:1.4.7
R_IMAGE=r-base:4.5.1
